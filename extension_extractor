

class ExtensionExtractor:
    
    def get_extension_from_phone_number(self, phone_number: str) -> str:

        input_for_next_entry: str = ''

        input_left = input

        result = []

        if input.startswith('+'):
            input_for_next_entry = '+'
            input_left = input[1:]

        for char in input_left:
            if char.isdigit():
                input_for_next_entry += char
            elif char == ' ' or char == '-' or char == '/' or char == '(' or char == ')':
                if input_for_next_entry != '':
                    result.append(input_for_next_entry)
                    input_for_next_entry = ''

            else:
                raise ValueError(f"Invalid character in input: {char}")
            
        if input_for_next_entry != '':
            result.append(input_for_next_entry)

        return result